{
  "name": "aberturas-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:list": "tsx src/scripts/migrate.ts --list",
    "migrate:dry": "tsx src/scripts/migrate.ts --dry",
    "changelog:add": "tsx src/scripts/add-changelog.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@sentry/node": "^10.56.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.7.4",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.3",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.19",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  }
}
