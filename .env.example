# Aberturas — Variables de entorno
# Copiá este archivo como .env y completá los valores
# Generación automática: bash setup.sh

POSTGRES_PASSWORD=cambia_esto
JWT_SECRET=cambia_esto_tambien

# Puerto en el que se expone la aplicación
APP_PORT=3000

# URL pública del sistema (usada para generar links de aprobación de presupuestos)
# En VPS con dominio: APP_URL=https://tudominio.com
# En VPS con IP: APP_URL=http://149.50.150.131:3000
APP_URL=http://localhost:3000

# Evolution API — WhatsApp (https://evolution-api.com)
# Instancia ya configurada y con QR escaneado en el servidor
EVOLUTION_API_URL=http://tu-servidor:8080
EVOLUTION_API_KEY=cambia_esto
EVOLUTION_INSTANCE=nombre_instancia

# Sentry — monitoreo de errores (https://sentry.io)
VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Email (SMTP Gmail)
# Sin SMTP_USER/SMTP_PASS configuradas: emails omitidos silenciosamente (no rompe nada).
# SMTP_PASS es una "Contraseña de aplicación" de Google (Cuenta Google > Seguridad > Verificación
# en 2 pasos > Contraseñas de aplicaciones) — la contraseña normal de Gmail NO funciona por SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucuenta@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Dirección a la que llegan las respuestas si el cliente responde el email (opcional,
# por defecto responde a SMTP_USER)
SMTP_REPLY_TO=contacto@tudominio.com
